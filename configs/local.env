# Local defaults — prod-shaped at 50k events/minute (~833/sec)
# Backend switch (same code as GCP):
#   USE_ALLOYDB=false  → Compose Postgres (or Cloud SQL when APP_ENV=prod)
#   USE_ALLOYDB=true   → AlloyDB Auth Proxy URL in DATABASE_URL
#   DEMO_SEED=true     → allow bootstrap/seed demo data (never in prod)
APP_ENV=local
LOG_LEVEL=INFO
USE_ALLOYDB=false
DEMO_SEED=true

KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

CHECKPOINT_TOPIC=checkpoint.events.v1
RETRY_TOPIC=checkpoint.retry.v1
DLQ_TOPIC=checkpoint.dlq.v1
AGGREGATION_TOPIC=aggregation.completed.v1
CHECKPOINT_PARTITIONS=12
CONSUMER_GROUP_ID=checkpoint-aggregation-service
REPORTING_CONSUMER_GROUP_ID=reporting-service

DATABASE_URL=postgresql+psycopg://checkpoint:checkpoint@localhost:5432/aggregation
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=30
REDIS_ENABLED=true

KAFKA_REPLICATION_FACTOR=1
KAFKA_THROUGHPUT_MODE=high
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=500
METRICS_PORT=8000
API_HOST=0.0.0.0
API_PORT=8080
