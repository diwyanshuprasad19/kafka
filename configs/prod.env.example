# Production — copy to configs/prod.env and fill in. Never commit real secrets:
# prefer injecting the credential lines from Secret Manager at deploy time.
#
# Verify before deploying:  APP_ENV=prod python scripts/preflight.py
# It refuses to pass while any localhost default or placeholder is still in place.

APP_ENV=prod
LOG_LEVEL=INFO

# Backend switch — same Python code as local; flip these only:
#   USE_ALLOYDB=false → Cloud SQL (unix socket /cloudsql/PROJECT:REGION:INSTANCE)
#   USE_ALLOYDB=true  → AlloyDB (Auth Proxy on 127.0.0.1 or private IP + TLS)
#   DEMO_SEED=false   → required in prod (preflight FAILS if true)
USE_ALLOYDB=false
DEMO_SEED=false
# When USE_ALLOYDB=false (Cloud SQL connector on Cloud Run):
CLOUD_SQL_INSTANCE=PROJECT_ID:REGION:checkpoint-pg
# When USE_ALLOYDB=true:
# ALLOYDB_CLUSTER=...
# ALLOYDB_INSTANCE=...

# --- Kafka -----------------------------------------------------------------
# Confluent Cloud. For MSK with SCRAM, keep SASL_SSL and set the mechanism to
# SCRAM-SHA-512. MSK IAM auth is not supported by this build — it needs an
# OAUTHBEARER token callback, so use SCRAM or TLS client certs there.
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.region.gcp.confluent.cloud:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# Only needed when the broker's CA is not in the system trust store.
KAFKA_SSL_CA_LOCATION=

CHECKPOINT_TOPIC=checkpoint.events.v1
RETRY_TOPIC=checkpoint.retry.v1
DLQ_TOPIC=checkpoint.dlq.v1
AGGREGATION_TOPIC=aggregation.completed.v1

# Partition count is the ceiling on consumer parallelism and Kafka cannot reduce
# it later, so size it for peak, not for today.
CHECKPOINT_PARTITIONS=12
# 3 on any cluster with 3+ brokers. Topics are created with
# min.insync.replicas=2 when this is >1, which is what makes acks=all durable.
KAFKA_REPLICATION_FACTOR=3
KAFKA_THROUGHPUT_MODE=high
CONSUMER_GROUP_ID=checkpoint-aggregation-service
REPORTING_CONSUMER_GROUP_ID=reporting-service
# The DLQ must outlive the incident that filled it.
DLQ_TOPIC_RETENTION_DAYS=30

# --- PostgreSQL / AlloyDB --------------------------------------------------
# Via the AlloyDB Auth Proxy (127.0.0.1) or a private IP with TLS. Direct
# connections should carry ?sslmode=require.
DATABASE_URL=postgresql+psycopg://checkpoint:CHANGE_ME@127.0.0.1:5433/aggregation
# Pool per process. Total connections = (pool + overflow) x replicas, which must
# stay under the instance's max_connections.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# --- Redis / Memorystore ---------------------------------------------------
# Cache only: if it is down the API still answers correctly from PostgreSQL.
# Use rediss:// when the instance offers TLS.
REDIS_URL=redis://MEMORYSTORE_IP:6379/0
REDIS_CACHE_TTL_SECONDS=30
REDIS_ENABLED=true

# --- Processing ------------------------------------------------------------
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=500
# One DB transaction and one offset commit per batch.
CONSUMER_BATCH_SIZE=200
CONSUMER_POLL_TIMEOUT_SECONDS=1.0
RETRY_MAX_INLINE_WAIT_SECONDS=1.0

# --- Domain rules ----------------------------------------------------------
# Decides which business day an event belongs to. A wrong value silently files
# events under the wrong date, so set it to the cafeterias' local zone.
BUSINESS_TIMEZONE=Asia/Kolkata
# Reject device clock skew beyond this many seconds into the future.
MAX_CLOCK_SKEW_SECONDS=900
# Sanity ceiling for one quantity reading; above this is a faulty sensor.
MAX_QUANTITY_KG=100000

# --- Rollups and retention -------------------------------------------------
# Upper bound on how stale cafe/client aggregates are. Counter level is always
# exact and synchronous.
ROLLUP_INTERVAL_SECONDS=5
PROCESSED_EVENTS_RETENTION_HOURS=72
HISTORY_RETENTION_DAYS=90
OUTBOX_RETENTION_HOURS=24
DLQ_RETENTION_DAYS=30
MAINTENANCE_INTERVAL_SECONDS=300

# --- Serving ---------------------------------------------------------------
METRICS_PORT=8000
API_HOST=0.0.0.0
API_PORT=8080

# --- GCP -------------------------------------------------------------------
GCP_PROJECT_ID=
GCP_REGION=asia-south1
ALLOYDB_CLUSTER=
ALLOYDB_INSTANCE=
