# Scale profile: 50,000 events / minute (≈ 833 / second)
APP_ENV=local
KAFKA_THROUGHPUT_MODE=high
CHECKPOINT_PARTITIONS=12
KAFKA_REPLICATION_FACTOR=1
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=200
LOG_LEVEL=INFO
